# Foundry deployment variables
PRIVATE_KEY=0x...your_deployer_private_key

# Uniswap V4 PoolManager address (canonical on Unichain Sepolia / Ethereum Sepolia)
POOL_MANAGER=0x000000000004444c5dc75cB358380D2e3dE08A90

# Optional: initialize pool with these tokens
# TOKEN0=0x...
# TOKEN1=0x...

# For fork tests
# ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
